# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# CLOUD vs LOCAL Configuration
# ============================================
# Set CLOUD_RUN=true to use cloud Ollama API (requires API key)
# Set CLOUD_RUN=false to use local Ollama server (no API key needed)
CLOUD_RUN=false

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# ============================================
# Local Ollama Configuration (CLOUD_RUN=false)
# ============================================
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen3:8b

# ============================================
# Cloud Ollama Configuration (CLOUD_RUN=true)
# ============================================
OLLAMA_CLOUD_URL=https://ollama.com/api
OLLAMA_CLOUD_MODEL=qwen3.5:397b
OLLAMA_API_KEY=your-cloud-api-key-here

# ============================================
# Common Ollama Settings
# ============================================
OLLAMA_TIMEOUT=600

# PII Masking Configuration
ENABLE_PII_MASKING=true
PII_MASKING_METHOD=presidio  # 'presidio' (recommended) or 'regex'

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=200

# Report Configuration
REPORT_OUTPUT_DIR=/app/results

# Azure AD Authentication
ENABLE_AUTH=true
AZURE_AD_TENANT_ID=your-tenant-id-here
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_REDIRECT_URI=http://localhost:8501

# Azure Configuration (for deployment)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
CONTAINER_REGISTRY_NAME=your-acr-name
